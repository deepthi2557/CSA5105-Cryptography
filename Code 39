freq = "ETAOINSHRDLCUMWFGYPBVKJXQZ"
text = input("Ciphertext: ").upper()
top = int(input("Top results: "))
ans = []
for k in range(26):
    p = ''.join(
        chr((ord(c)-65-k) % 26 + 65) if c.isalpha() else c
        for c in text
    )
    score = sum(p.count(x) for x in freq[:10])
    ans.append((score, p))
for i, (score, p) in enumerate(sorted(ans, reverse=True)[:top], 1):
    print(i, p)
