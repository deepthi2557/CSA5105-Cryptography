import math
def inv(a):
    for i in range(26):
        if a*i % 26 == 1:
            return i
    return None
P = [[7,4], [11,15]]
C = [[19,8], [3,19]]
det = (P[0][0]*P[1][1]-P[0][1]*P[1][0]) % 26
d = inv(det)
if d is None:
    print("Cannot recover key")
else:
    Pinv = [
        [P[1][1]*d % 26, -P[0][1]*d % 26],
        [-P[1][0]*d % 26, P[0][0]*d % 26]
    ]
    K = [
        [sum(C[i][k]*Pinv[k][j] for k in range(2)) % 26
         for j in range(2)]
        for i in range(2)
    ]
    print("Recovered key:")
    for row in K:
        print(row)
