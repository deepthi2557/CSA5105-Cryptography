S = [[1 if 5*y+x < 16 else 0 for x in range(5)]
     for y in range(5)]
for r in range(1, 10):
    C = [sum(S[y][x] for y in range(5)) % 2 for x in range(5)]
    D = [C[(x-1)%5] ^ C[(x+1)%5] for x in range(5)]
    S = [[S[y][x] ^ D[x] for x in range(5)]
         for y in range(5)]
    zero = sum(S[y][x] == 0 for y in range(5) for x in range(5))
    print("Round", r, "zero lanes =", zero)
    if all(S[y][x] for y in range(5) for x in range(5)):
        print("All lanes are nonzero after round", r)
        break
