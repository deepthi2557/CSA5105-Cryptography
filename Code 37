freq = "ETAOINSHRDLCUMWFGYPBVKJXQZ"
def attack(text, top=10):
    count = {c:0 for c in "ABCDEFGHIJKLMNOPQRSTUVWXYZ"}

    for c in text.upper():
        if c.isalpha():
            count[c] += 1
    cipher = sorted(count, key=count.get, reverse=True)
    for n in range(min(top, 26)):
        mp = dict(zip(cipher, freq[n:] + freq[:n]))
        out = ''.join(mp.get(c, c) for c in text.upper())
        print(n+1, out)
text = input("Ciphertext: ")
attack(text, 10)
